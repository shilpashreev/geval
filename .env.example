# Copy to .env (gitignored) and fill in. DeepEval grades every metric with an
# LLM judge. Pick ONE provider; keys are read from here, never hardcoded.

# Provider: ollama (offline, default) | openai | anthropic
DEEPEVAL_JUDGE_PROVIDER=ollama

# --- openai judge ---
# OPENAI_API_KEY=sk-...
# DEEPEVAL_OPENAI_MODEL=gpt-4o-mini      # gpt-4o for stricter grading

# --- anthropic judge ---
# ANTHROPIC_API_KEY=sk-ant-...
# DEEPEVAL_JUDGE_MODEL=claude-sonnet-4-6-20250514

# --- ollama judge (local) ---
# DEEPEVAL_OLLAMA_MODEL=gemma3:4b
# OLLAMA_BASE_URL=http://localhost:11434

# --- shared ---
# DEEPEVAL_THRESHOLD=0.7
# DEEPEVAL_JUDGE_TEMPERATURE=0.0
